[Unit]
Description=ANTItrading Autonomous Paper-Trading Pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ANTItrading
EnvironmentFile=-/opt/ANTItrading/.env
ExecStart=/opt/ANTItrading/deploy/run_and_sync.sh
StandardOutput=append:/var/log/antitrader.log
StandardError=append:/var/log/antitrader.log

[Install]
WantedBy=multi-user.target
