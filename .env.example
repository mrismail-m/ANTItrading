# ===============================================================================
# ANTItrading Environment Configuration Example
# ===============================================================================
# Copy this file to .env or set these in your GitHub Repository Secrets:
# Settings -> Secrets and variables -> Actions -> Repository secrets
#
# Discord Webhook URL for autonomous trade execution notifications
# Format: https://discord.com/api/webhooks/<WEBHOOK_ID>/<WEBHOOK_TOKEN>
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Appwrite Cloud Database Configuration (optional overrides; defaults to nyc.cloud.appwrite.io)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_DATABASE_ID=antitrader
APPWRITE_API_KEY=your_appwrite_api_key_or_scoped_key

